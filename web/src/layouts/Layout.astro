---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ArgusReview — AI code review',
  description = 'AI-powered code review for GitHub, GitLab, Bitbucket, Azure DevOps and Gitea. Configure it in seconds.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={base}>
          <span class="logo">👁️</span> ArgusReview
        </a>
        <nav class="nav">
          <a href={`${base}#features`}>Features</a>
          <a href={`${base}#providers`}>Providers</a>
          <a href={`${base}config`}>Config Builder</a>
          <a href={`${base}#about`}>About</a>
          <a href="https://github.com/sang-hv/argus-code-review" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          ArgusReview — open-source AI code reviewer · maintained by
          <strong>Hoang Van Sang</strong> ·
          <a href="mailto:supersentaj@gmail.com">supersentaj@gmail.com</a>
        </p>
        <p>
          A fork of ArgusReview (originally <a href="https://github.com/Nikita-Filonov/ai-review" target="_blank" rel="noopener">ai-review</a>),
          licensed under Apache-2.0.
        </p>
      </div>
    </footer>
  </body>
</html>
