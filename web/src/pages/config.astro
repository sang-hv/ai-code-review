---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="ArgusReview — Config Builder" description="Generate your .ai-review.yaml config by picking options.">
  <section class="section" style="border-top:none; padding-top:40px;">
    <div class="container">
      <h2>⚡ Config Builder</h2>
      <p class="lead">
        Fields are generated live from the tool's own config schema, so they never drift from the code.
        Tokens are emitted as <code>{"${ENV}"}</code> placeholders — never real secrets.
      </p>

      <div class="builder">
        <div class="form-col">
          <fieldset class="fieldset">
            <legend>LLM</legend>
            <div class="field">
              <label for="llm-provider">Provider</label>
              <select id="llm-provider"></select>
            </div>
            <div id="llm-groups"></div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>VCS</legend>
            <div class="field">
              <label for="vcs-provider">Provider</label>
              <select id="vcs-provider"></select>
            </div>
            <div id="vcs-groups"></div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>Review</legend>
            <div class="field">
              <label for="review-language">Response language</label>
              <input id="review-language" type="text" value="English" />
              <span class="hint">Free-form: English, Vietnamese, 日本語, ...</span>
            </div>
            <div class="field">
              <label for="review-mode">Mode</label>
              <select id="review-mode"></select>
            </div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>Coding conventions (optional)</legend>
            <div class="field">
              <div class="checkbox-row">
                <input id="conv-enabled" type="checkbox" />
                <label for="conv-enabled" style="margin:0;">Load project coding conventions</label>
              </div>
            </div>
            <div class="field hidden" id="wrap-conv-path">
              <label for="conv-path">Local path (file or folder of .md)</label>
              <input id="conv-path" type="text" value="./AGENTS.md" />
            </div>
          </fieldset>
        </div>

        <div class="output-col">
          <div class="output-head">
            <strong>.ai-review.yaml</strong>
            <div style="display:flex; gap:8px;">
              <button class="btn btn-ghost" id="btn-copy" type="button">Copy</button>
              <button class="btn btn-primary" id="btn-download" type="button">Download</button>
            </div>
          </div>
          <pre class="yaml" id="yaml-out" data-base={base}>loading schema…</pre>
          <p class="note">
            Commit this to your repo root. Set the referenced token env vars as CI/CD secrets — they
            override the file at runtime.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    import yaml from 'js-yaml';
    import { providerKeys, variantGroups, fieldsForRef, enumValues } from '../lib/schema.js';

    const $ = (id) => document.getElementById(id);
    const base = $('yaml-out').dataset.base || '/';
    const SKIP = ['proxy_url']; // advanced, keep the form clean

    // UX-only suggestions (structure is 100% from schema; these just prefill blanks)
    const URL_PREFILL = {
      OPENAI: 'https://api.openai.com/v1', GEMINI: 'https://generativelanguage.googleapis.com',
      CLAUDE: 'https://api.anthropic.com', OLLAMA: 'http://localhost:11434',
      BEDROCK: 'https://bedrock-runtime.us-east-1.amazonaws.com', OPENROUTER: 'https://openrouter.ai/api/v1',
      AZURE_OPENAI: 'https://<resource>.openai.azure.com', OPENAI_COMPATIBLE: 'https://my-router.example.com/v1',
      GITHUB: 'https://api.github.com', GITLAB: '${CI_SERVER_URL}', GITEA: 'https://gitea.example.com/api/v1',
      AZURE_DEVOPS: 'https://dev.azure.com', BITBUCKET_CLOUD: 'https://api.bitbucket.org/2.0',
      BITBUCKET_SERVER: 'https://bitbucket.example.com/rest/api/1.0',
    };
    const TOKEN_PREFILL = {
      access_key: 'AWS_ACCESS_KEY_ID', secret_key: 'AWS_SECRET_ACCESS_KEY',
      'llm.api_token': 'LLM_API_TOKEN', 'vcs.api_token': 'GITLAB_API_TOKEN',
    };
    const ALWAYS = new Set(['model', 'api_url', 'api_token', 'access_key', 'secret_key']);

    let schema = null;

    function fieldRow(section, group, f) {
      const id = `f-${section}-${group}-${f.name}`;
      const label = `${group}.${f.name}${f.required ? ' *' : ''}`;
      let control;
      if (f.kind === 'bool') {
        const checked = f.default === true ? 'checked' : '';
        control = `<div class="checkbox-row"><input type="checkbox" id="${id}" ${checked}
          data-section="${section}" data-group="${group}" data-name="${f.name}" data-kind="bool" data-default="${f.default}" />
          <label for="${id}" style="margin:0;">${label}</label></div>`;
        return `<div class="field">${control}</div>`;
      }
      if (f.kind === 'enum') {
        const opts = f.options.map((o) => `<option value="${o}" ${o === f.default ? 'selected' : ''}>${o}</option>`).join('');
        control = `<select id="${id}" data-section="${section}" data-group="${group}" data-name="${f.name}" data-kind="enum" data-default="${f.default}">${opts}</select>`;
      } else {
        const type = f.kind === 'number' ? 'number' : 'text';
        let val = f.default ?? '';
        if (f.name === 'api_url' && URL_PREFILL[currentProvider(section)]) val = URL_PREFILL[currentProvider(section)];
        if (f.kind === 'password') val = TOKEN_PREFILL[f.name] || TOKEN_PREFILL[`${section}.${f.name}`] || 'API_TOKEN';
        control = `<input type="${type}" id="${id}" value="${val}"
          data-section="${section}" data-group="${group}" data-name="${f.name}" data-kind="${f.kind}" data-default="${f.default}" data-required="${f.required}" />`;
      }
      const hint = f.kind === 'password' ? '<span class="hint">Env var name — emitted wrapped in ${...}.</span>' : '';
      return `<div class="field"><label for="${id}">${label}</label>${control}${hint}</div>`;
    }

    function currentProvider(section) { return $(`${section}-provider`).value; }

    function renderGroups(section) {
      const provider = currentProvider(section);
      const container = $(`${section}-groups`);
      const groups = variantGroups(schema, section, provider);
      container.innerHTML = groups
        .map((g) => fieldsForRef(schema, g.ref, { skip: SKIP }).map((f) => fieldRow(section, g.name, f)).join(''))
        .join('');
      container.querySelectorAll('input, select').forEach((el) => el.addEventListener('input', render));
    }

    function coerce(el) {
      const kind = el.dataset.kind;
      if (kind === 'bool') return el.checked;
      const raw = el.value.trim();
      if (raw === '') return null;
      if (kind === 'number') return Number(raw);
      if (kind === 'password') return '${' + raw + '}';
      return raw;
    }

    function collectSection(section) {
      const obj = { provider: currentProvider(section) };
      $(`${section}-groups`).querySelectorAll('input, select').forEach((el) => {
        const { group, name, kind } = el.dataset;
        const value = coerce(el);
        const def = el.dataset.default;
        const isDefault = value !== null && String(value) === def;
        const required = el.dataset.required === 'true' || kind === 'bool';
        // keep it minimal: always-essential fields, required fields, or changed-from-default
        const keep = ALWAYS.has(name) || required || (value !== null && !isDefault && !(kind === 'bool' && value === (def === 'true')));
        if (value === null || !keep) return;
        (obj[group] ??= {})[name] = value;
      });
      return obj;
    }

    function render() {
      if (!schema) return;
      const config = {
        llm: collectSection('llm'),
        vcs: collectSection('vcs'),
        review: { mode: $('review-mode').value, language: $('review-language').value || 'English' },
      };
      if ($('conv-enabled').checked) {
        config.conventions = { enabled: true, sources: [{ type: 'local', path: $('conv-path').value }] };
      }
      const body = yaml.dump(config, { indent: 2, lineWidth: 100, quotingType: '"' });
      $('yaml-out').textContent =
        '# .ai-review.yaml — generated by the ArgusReview config builder\n' +
        '# Token env vars (${...}) must be provided as CI/CD secrets at runtime.\n\n' + body;
    }

    async function init() {
      const res = await fetch(`${base}schema.json`);
      schema = await res.json();

      for (const p of providerKeys(schema, 'llm')) $('llm-provider').add(new Option(p, p, p === 'OPENAI', p === 'OPENAI'));
      for (const p of providerKeys(schema, 'vcs')) $('vcs-provider').add(new Option(p, p, p === 'GITHUB', p === 'GITHUB'));
      for (const m of enumValues(schema, '#/$defs/ReviewMode')) $('review-mode').add(new Option(m, m));

      $('llm-provider').addEventListener('change', () => { renderGroups('llm'); render(); });
      $('vcs-provider').addEventListener('change', () => { renderGroups('vcs'); render(); });
      ['review-language', 'review-mode', 'conv-enabled', 'conv-path'].forEach((id) => $(id).addEventListener('input', render));
      $('conv-enabled').addEventListener('change', () => { $('wrap-conv-path').classList.toggle('hidden', !$('conv-enabled').checked); render(); });

      renderGroups('llm');
      renderGroups('vcs');
      render();
    }

    $('btn-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText($('yaml-out').textContent || '');
      $('btn-copy').textContent = 'Copied!';
      setTimeout(() => ($('btn-copy').textContent = 'Copy'), 1500);
    });
    $('btn-download').addEventListener('click', () => {
      const blob = new Blob([$('yaml-out').textContent || ''], { type: 'text/yaml' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = '.ai-review.yaml';
      a.click();
      URL.revokeObjectURL(a.href);
    });

    init();
  </script>
</Layout>
