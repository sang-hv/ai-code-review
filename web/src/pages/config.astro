---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="ArgusReview — Config Builder" description="Generate your .ai-review.yaml + CI setup by picking options.">
  <section class="section" style="border-top:none; padding-top:40px;">
    <div class="container">
      <h2>⚡ Config Builder</h2>
      <p class="lead">
        Pick your options — get a ready <code>.ai-review.yaml</code> plus the exact CI job and secrets to add.
        Secrets are never written into the YAML (the tool doesn't expand <code>{"${...}"}</code> in files);
        they go into your CI as env vars.
      </p>

      <div class="builder">
        <div class="form-col">
          <fieldset class="fieldset">
            <legend>LLM</legend>
            <div class="field">
              <label for="llm-provider">Provider</label>
              <select id="llm-provider"></select>
            </div>
            <div id="llm-groups"></div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>VCS</legend>
            <div class="field">
              <label for="vcs-provider">Provider</label>
              <select id="vcs-provider"></select>
              <span class="hint">Pipeline info & tokens are supplied by your CI (see the CI setup panel).</span>
            </div>
            <div class="field">
              <div class="checkbox-row">
                <input id="vcs-insecure" type="checkbox" />
                <label for="vcs-insecure" style="margin:0;">Self-hosted with internal CA — disable SSL verify</label>
              </div>
            </div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>Review</legend>
            <div class="field">
              <label for="review-language">Response language</label>
              <input id="review-language" type="text" value="English" />
              <span class="hint">Free-form: English, Vietnamese, 日本語, ...</span>
            </div>
            <div class="field">
              <label for="review-mode">Mode</label>
              <select id="review-mode"></select>
              <span class="hint">
                Which slice of each changed file the model sees.<br />
                • <strong>ADDED_AND_REMOVED_WITH_CONTEXT</strong> — recommended default: changed lines + surrounding context. Good quality at moderate quota.<br />
                • <strong>FULL_FILE_DIFF</strong> — full unified diff of changed files (more context, more tokens).<br />
                • <strong>FULL_FILE_CURRENT / FULL_FILE_PREVIOUS</strong> — the whole file after / before changes. Needed for whole-file rules (e.g. "max 300 lines per file"); highest token cost.<br />
                • <strong>ONLY_ADDED / ONLY_REMOVED / ADDED_AND_REMOVED</strong> — leanest, changed lines only.<br />
                Tip: for whole-file conventions, use FULL_FILE_CURRENT, or enable Agent mode so the model can read files on demand without loading every file in full.
              </span>
            </div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>Coding conventions (optional)</legend>
            <div class="field">
              <div class="checkbox-row">
                <input id="conv-enabled" type="checkbox" />
                <label for="conv-enabled" style="margin:0;">Load project coding conventions</label>
              </div>
            </div>
            <div id="conv-body" class="hidden">
              <div class="field">
                <label for="conv-type">Source type</label>
                <select id="conv-type">
                  <option value="local" selected>local (file or folder)</option>
                  <option value="url">url (raw .md)</option>
                  <option value="git">git repo</option>
                </select>
              </div>
              <div class="field conv-local">
                <label for="conv-path">Local path</label>
                <input id="conv-path" type="text" value="./AGENTS.md" />
              </div>
              <div class="field conv-url hidden">
                <label for="conv-url-val">Raw .md URL</label>
                <input id="conv-url-val" type="text" value="https://raw.githubusercontent.com/org/standards/main/STYLE.md" />
              </div>
              <div class="field conv-git hidden">
                <label for="conv-repo">Git repo URL</label>
                <input id="conv-repo" type="text" value="https://github.com/org/standards.git" />
              </div>
              <div class="field conv-git hidden">
                <label for="conv-ref">Ref (branch/tag)</label>
                <input id="conv-ref" type="text" value="main" />
              </div>
              <div class="field conv-git hidden">
                <label for="conv-gitpath">Path within repo</label>
                <input id="conv-gitpath" type="text" value="." />
              </div>
            </div>
          </fieldset>

          <fieldset class="fieldset">
            <legend>Agent mode (optional)</legend>
            <div class="field">
              <div class="checkbox-row">
                <input id="agent-enabled" type="checkbox" />
                <label for="agent-enabled" style="margin:0;">Enable agent mode — let the model explore the repo before reviewing</label>
              </div>
              <span class="hint">Also powers the low-quota <code>run-agent</code> / <code>run-agent-inline</code> / <code>run-agent-summary</code> commands.</span>
            </div>
            <div class="field hidden" id="wrap-agent-iter">
              <label for="agent-iter">Max iterations</label>
              <input id="agent-iter" type="number" value="25" />
            </div>
            <div class="field hidden" id="wrap-agent-history">
              <label for="agent-history">Max history chars</label>
              <input id="agent-history" type="number" value="24000" />
              <span class="hint">Caps re-sent tool-output history per step to keep quota bounded.</span>
            </div>
          </fieldset>
        </div>

        <div class="output-col" data-base={base}>
          <div class="output-head">
            <strong>① .ai-review.yaml <span class="hint">(commit to repo root)</span></strong>
            <div style="display:flex; gap:8px;">
              <button class="btn btn-ghost" id="btn-copy" type="button">Copy</button>
              <button class="btn btn-primary" id="btn-download" type="button">Download</button>
            </div>
          </div>
          <pre class="yaml" id="yaml-out">loading schema…</pre>

          <div class="output-head" style="margin-top:22px;">
            <strong>② CI setup — <span id="ci-platform">…</span></strong>
            <button class="btn btn-ghost" id="btn-copy-ci" type="button">Copy</button>
          </div>
          <p class="note" id="ci-file"></p>
          <pre class="yaml" id="ci-out"></pre>

          <div style="margin-top:16px;">
            <strong>③ Secrets to create in your CI</strong>
            <ul class="note" id="secrets-list" style="margin-top:8px;"></ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import yaml from 'js-yaml';
    import { providerKeys, variantGroups, fieldsForRef, enumValues } from '../lib/schema.js';
    import { ciIntegration } from '../lib/ci.js';

    const $ = (id) => document.getElementById(id);
    const base = document.querySelector('.output-col').dataset.base || '/';

    const SKIP = ['proxy_url'];
    const SECRET_NAMES = new Set(['api_token', 'access_key', 'secret_key', 'session_token']);
    const ALWAYS = new Set(['model', 'api_url']);
    const URL_PREFILL = {
      OPENAI: 'https://api.openai.com/v1', GEMINI: 'https://generativelanguage.googleapis.com',
      CLAUDE: 'https://api.anthropic.com', OLLAMA: 'http://localhost:11434',
      BEDROCK: 'https://bedrock-runtime.us-east-1.amazonaws.com', OPENROUTER: 'https://openrouter.ai/api/v1',
      AZURE_OPENAI: 'https://<resource>.openai.azure.com', OPENAI_COMPATIBLE: 'https://my-router.example.com/v1',
    };
    const SECRET_PREFILL = { api_token: 'LLM_API_TOKEN', access_key: 'AWS_ACCESS_KEY_ID', secret_key: 'AWS_SECRET_ACCESS_KEY', session_token: 'AWS_SESSION_TOKEN' };

    let schema = null;

    function isSecretField(f) { return f.kind === 'password' || SECRET_NAMES.has(f.name); }

    function fieldRow(group, f) {
      const id = `f-llm-${group}-${f.name}`;
      const secret = isSecretField(f);
      const label = `${group}.${f.name}${f.required ? ' *' : ''}`;
      if (secret) {
        const val = SECRET_PREFILL[f.name] || 'API_TOKEN';
        return `<div class="field"><label for="${id}">${label} <span class="hint">(secret → env)</span></label>
          <input type="text" id="${id}" value="${val}" data-group="${group}" data-name="${f.name}" data-secret="1" />
          <span class="hint">Env var name — set as a CI secret, not in the YAML.</span></div>`;
      }
      if (f.kind === 'bool') {
        const checked = f.default === true ? 'checked' : '';
        return `<div class="field"><div class="checkbox-row"><input type="checkbox" id="${id}" ${checked}
          data-group="${group}" data-name="${f.name}" data-kind="bool" data-default="${f.default}" />
          <label for="${id}" style="margin:0;">${label}</label></div></div>`;
      }
      if (f.kind === 'enum') {
        const opts = f.options.map((o) => `<option value="${o}" ${o === f.default ? 'selected' : ''}>${o}</option>`).join('');
        return `<div class="field"><label for="${id}">${label}</label>
          <select id="${id}" data-group="${group}" data-name="${f.name}" data-kind="enum" data-default="${f.default}">${opts}</select></div>`;
      }
      const type = f.kind === 'number' ? 'number' : 'text';
      let val = f.default ?? '';
      if (f.name === 'api_url' && URL_PREFILL[$('llm-provider').value]) val = URL_PREFILL[$('llm-provider').value];
      return `<div class="field"><label for="${id}">${label}</label>
        <input type="${type}" id="${id}" value="${val}" data-group="${group}" data-name="${f.name}" data-kind="${f.kind}" data-default="${f.default}" data-required="${f.required}" /></div>`;
    }

    function renderLlmGroups() {
      const provider = $('llm-provider').value;
      const container = $('llm-groups');
      container.innerHTML = variantGroups(schema, 'llm', provider)
        .map((g) => fieldsForRef(schema, g.ref, { skip: SKIP }).map((f) => fieldRow(g.name, f)).join(''))
        .join('');
      container.querySelectorAll('input, select').forEach((el) => el.addEventListener('input', render));
    }

    function coerce(el) {
      const kind = el.dataset.kind;
      if (kind === 'bool') return el.checked;
      const raw = el.value.trim();
      if (raw === '') return null;
      if (kind === 'number') return Number(raw);
      return raw;
    }

    function collectLlm() {
      const obj = { provider: $('llm-provider').value };
      const secrets = [];
      $('llm-groups').querySelectorAll('input, select').forEach((el) => {
        const { group, name } = el.dataset;
        if (el.dataset.secret === '1') {
          const envName = el.value.trim();
          if (envName) secrets.push({ name: envName, env: `LLM__${group.toUpperCase()}__${name.toUpperCase()}`, desc: `LLM ${name}` });
          return; // never in YAML
        }
        const value = coerce(el);
        if (value === null) return;
        const def = el.dataset.default;
        const required = el.dataset.required === 'true' || el.dataset.kind === 'bool';
        const isDefault = String(value) === def;
        if (!(ALWAYS.has(name) || required || !isDefault)) return;
        (obj[group] ??= {})[name] = value;
      });
      return { obj, secrets };
    }

    function render() {
      if (!schema) return;
      const llm = collectLlm();

      const config = {
        llm: llm.obj,
        vcs: { provider: $('vcs-provider').value },
        review: { mode: $('review-mode').value, language: $('review-language').value || 'English' },
      };
      if ($('conv-enabled').checked) {
        const t = $('conv-type').value;
        let src;
        if (t === 'local') src = { type: 'local', path: $('conv-path').value };
        else if (t === 'url') src = { type: 'url', url: $('conv-url-val').value };
        else src = { type: 'git', repo: $('conv-repo').value, ref: $('conv-ref').value, path: $('conv-gitpath').value };
        config.conventions = { enabled: true, sources: [src] };
      }
      if ($('agent-enabled').checked) {
        config.agent = {
          enabled: true,
          max_iterations: Number($('agent-iter').value) || 25,
          max_history_chars: Number($('agent-history').value) || 24000,
        };
      }

      const body = yaml.dump(config, { indent: 2, lineWidth: 100, quotingType: '"' });
      $('yaml-out').textContent =
        '# .ai-review.yaml — commit to your repo root.\n' +
        '# Secrets (tokens) are NOT here — they go into CI as env vars (see below).\n\n' + body;

      // --- CI panel ---
      const ci = ciIntegration($('vcs-provider').value, llm.secrets);
      $('ci-platform').textContent = ci.platform;
      $('ci-file').textContent = `Add to: ${ci.filename}` + (ci.note ? `  •  ${ci.note}` : '');
      let snippet = ci.snippet;
      if ($('vcs-insecure').checked) {
        snippet += '\n# self-hosted: also set  VCS__HTTP_CLIENT__VERIFY=false';
      }
      $('ci-out').textContent = snippet;

      const secretsUl = $('secrets-list');
      const uniq = [...new Map(ci.secrets.map((s) => [s.name, s])).values()];
      secretsUl.innerHTML = uniq.length
        ? uniq.map((s) => `<li><code>${s.name}</code> — ${s.desc || 'secret value'}</li>`).join('')
        : '<li>None beyond the platform-provided token.</li>';
    }

    async function init() {
      schema = await (await fetch(`${base}schema.json`)).json();
      for (const p of providerKeys(schema, 'llm')) $('llm-provider').add(new Option(p, p, p === 'OPENAI', p === 'OPENAI'));
      for (const p of providerKeys(schema, 'vcs')) $('vcs-provider').add(new Option(p, p, p === 'GITHUB', p === 'GITHUB'));
      for (const m of enumValues(schema, '#/$defs/ReviewMode')) $('review-mode').add(new Option(m, m));

      $('llm-provider').addEventListener('change', () => { renderLlmGroups(); render(); });
      ['vcs-provider', 'vcs-insecure', 'review-language', 'review-mode',
        'conv-enabled', 'conv-type', 'conv-path', 'conv-url-val', 'conv-repo', 'conv-ref', 'conv-gitpath',
        'agent-enabled', 'agent-iter', 'agent-history'].forEach((id) => $(id).addEventListener('input', render));

      function updateConvFields() {
        const t = $('conv-type').value;
        document.querySelectorAll('.conv-local, .conv-url, .conv-git').forEach((el) => el.classList.add('hidden'));
        document.querySelectorAll('.conv-' + t).forEach((el) => el.classList.remove('hidden'));
      }
      $('conv-enabled').addEventListener('change', () => { $('conv-body').classList.toggle('hidden', !$('conv-enabled').checked); render(); });
      $('conv-type').addEventListener('change', updateConvFields);
      $('agent-enabled').addEventListener('change', () => {
        const on = $('agent-enabled').checked;
        $('wrap-agent-iter').classList.toggle('hidden', !on);
        $('wrap-agent-history').classList.toggle('hidden', !on);
        render();
      });
      updateConvFields();

      renderLlmGroups();
      render();
    }

    function copyEl(id, btn) {
      navigator.clipboard.writeText($(id).textContent || '');
      const t = btn.textContent; btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = t), 1500);
    }
    $('btn-copy').addEventListener('click', (e) => copyEl('yaml-out', e.target));
    $('btn-copy-ci').addEventListener('click', (e) => copyEl('ci-out', e.target));
    $('btn-download').addEventListener('click', () => {
      const blob = new Blob([$('yaml-out').textContent || ''], { type: 'text/yaml' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = '.ai-review.yaml';
      a.click();
      URL.revokeObjectURL(a.href);
    });

    init();
  </script>
</Layout>
