# The Docker image only needs the Python package + packaging metadata
# (see Dockerfile). Everything below is excluded from the build context to
# keep builds fast — none of it ends up in the image anyway.

# Web app (landing + config builder) — not part of the Python package
web/

# VCS / CI / docs / local review output
.git/
.github/
docs/
ci/
artifacts/

# Python build & env artifacts
.venv/
venv/
env/
build/
dist/
*.egg-info/
**/__pycache__/
*.py[cod]

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Editor / OS
.idea/
.vscode/
.DS_Store
